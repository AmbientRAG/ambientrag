# AmbientRAG Configuration
# Copy to .env and customize

# Database URL (T1: brew postgres, T2+: docker)
# AMBIENTRAG_DB_URL=postgresql://localhost/ambientrag

# Vault path (defaults to ~/.ambientrag/state.json vault_path)
# AMBIENTRAG_VAULT_PATH=/path/to/your/obsidian-vault

# MCP server port
# MCP_PORT=8100

# Embedding server
# EMBED_SERVER=http://127.0.0.1:8787

# Reranker server (CAP-006, T2+)
# RERANK_SERVER_URL=http://127.0.0.1:8788
